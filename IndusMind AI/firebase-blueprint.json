{
  "entities": {
    "users": {
      "title": "User Profiles",
      "description": "Enterprise users and their assigned industrial roles and plant locations",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string" },
        "plantLocation": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "documents": {
      "title": "Industrial Documents",
      "description": "Ingested technical SOPs, engineering drawings, manuals, and inspection reports",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string" },
        "fileType": { "type": "string" },
        "status": { "type": "string" },
        "equipmentId": { "type": "string" },
        "extractedEntities": { "type": "array", "items": { "type": "string" } },
        "summary": { "type": "string" },
        "confidence": { "type": "number" },
        "uploadedBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "category", "fileType", "status"]
    },
    "equipment": {
      "title": "Equipment Digital Twins",
      "description": "Live asset twins with health metrics, sensor readings, and RUL",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "plant": { "type": "string" },
        "status": { "type": "string" },
        "healthScore": { "type": "number" },
        "rulDays": { "type": "number" },
        "vibration": { "type": "number" },
        "temperature": { "type": "number" },
        "pressure": { "type": "number" },
        "rpm": { "type": "number" },
        "lastMaintenance": { "type": "string" },
        "nextMaintenance": { "type": "string" }
      },
      "required": ["code", "name", "type", "status", "healthScore"]
    },
    "workOrders": {
      "title": "Maintenance Work Orders",
      "description": "Predictive & corrective maintenance work orders synced real-time",
      "type": "object",
      "properties": {
        "orderId": { "type": "string" },
        "equipmentId": { "type": "string" },
        "equipmentName": { "type": "string" },
        "priority": { "type": "string" },
        "status": { "type": "string" },
        "assignedTo": { "type": "string" },
        "description": { "type": "string" },
        "recommendedSpares": { "type": "array", "items": { "type": "string" } },
        "dueDate": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["orderId", "equipmentId", "priority", "status"]
    },
    "incidents": {
      "title": "Operational Incidents & RCAs",
      "description": "Plant incidents, failure root causes, and CAPA recommendations",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "equipmentId": { "type": "string" },
        "severity": { "type": "string" },
        "status": { "type": "string" },
        "rootCause": { "type": "string" },
        "capa": { "type": "string" },
        "reportedBy": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["title", "severity", "status"]
    },
    "knowledgeGraph": {
      "title": "Knowledge Graph Items",
      "description": "Industrial knowledge graph entities and relationship edges",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "type": { "type": "string" },
        "category": { "type": "string" },
        "connections": { "type": "array", "items": { "type": "object" } }
      },
      "required": ["id", "label", "type"]
    },
    "complianceAudits": {
      "title": "Compliance Audits & Checklist",
      "description": "Regulatory compliance items, OISD/PESO/ISO findings, and audit evidence",
      "type": "object",
      "properties": {
        "regulation": { "type": "string" },
        "clause": { "type": "string" },
        "status": { "type": "string" },
        "findings": { "type": "string" },
        "riskLevel": { "type": "string" },
        "auditor": { "type": "string" },
        "lastChecked": { "type": "string" }
      },
      "required": ["regulation", "clause", "status"]
    },
    "agentLogs": {
      "title": "AI Agent Operations Stream",
      "description": "Live activity logs across Orion, Sentinel, Guardian, and Cortex agents",
      "type": "object",
      "properties": {
        "agentName": { "type": "string" },
        "action": { "type": "string" },
        "target": { "type": "string" },
        "status": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["agentName", "action", "status", "timestamp"]
    }
  }
}
